# Streamlit Community Cloud: paste this into Settings -> Secrets (not committed).
# For local use, copy to .streamlit/secrets.toml -- that file is gitignored.

ADMIN_KEY = "replace-me"

# Recommended whenever the data matters: a hosted container's disk is ephemeral,
# so SQLite is lost on restart.
DATABASE_URL = "postgresql://user:password@host:5432/dbname"

# Set once you know the app's public URL, to keep the container awake.
SELF_PING_URL = "https://your-app.streamlit.app"
SELF_PING_INTERVAL = "600"
