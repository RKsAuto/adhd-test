# Copy to .env for local runs, or set these in your host's environment/secrets UI.
# Never commit the real values.

# Required for the admin board. Without it the board stays locked for everyone.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=replace-me

# Postgres connection string. Leave unset to use the local SQLite file.
# Strongly recommended for any run whose data you cannot re-collect: hosted
# containers have ephemeral disks and a restart wipes SQLite.
# Supabase: Project Settings -> Database -> Connection string -> URI
# Neon:     Dashboard -> Connection Details -> Connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# SQLite file path, used only when DATABASE_URL is unset.
DB_PATH=data/submissions.db

# Keep-alive. Set to this app's own public URL to stop a free-tier container
# idling to sleep. Leave unset to disable.
SELF_PING_URL=https://your-app.streamlit.app
SELF_PING_INTERVAL=600
